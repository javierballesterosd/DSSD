                <expression xmi:type="expression:Expression" xmi:id="_9826fac06caa468bbc3b4b37abe31c96" name="Credenciales nacionales desde configuracion" content="def p = new java.util.Properties() def env = new File(System.getProperty(&quot;rescuesync.env&quot;, &quot;C:/Users/Usuario/Documents/GitHub/DSSD/Proyecto/.env&quot;)) if (!env.isFile()) throw new IllegalStateException(&quot;No se encontro la configuracion local de RescueSync&quot;) env.withInputStream { p.load(it) } def username = p.getProperty(&quot;NACIONAL_USERNAME&quot;)?.trim() def password = p.getProperty(&quot;NACIONAL_PASSWORD&quot;) if (!username || !password) throw new IllegalStateException(&quot;Faltan las credenciales nacionales&quot;) return groovy.json.JsonOutput.toJson([username: username, password: password])" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true" interpreter="GROOVY" returnType="java.lang.String"/>
              </parameters>
