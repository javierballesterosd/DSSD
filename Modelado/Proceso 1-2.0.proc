                <expression xmi:type="expression:Expression" xmi:id="_6d4df62504eb422199a86672c248f5c7" name="URL Sistema Nacional" content="def p = new java.util.Properties() def env = new File(System.getProperty(&quot;rescuesync.env&quot;, &quot;C:/Users/Usuario/Documents/GitHub/DSSD/Proyecto/.env&quot;)) if (!env.isFile()) throw new IllegalStateException(&quot;No se encontro la configuracion local de RescueSync&quot;) env.withInputStream { p.load(it) } def base = p.getProperty(&quot;NACIONAL_BASE_URL&quot;)?.trim() if (!base) throw new IllegalStateException(&quot;Falta NACIONAL_BASE_URL&quot;) return base.replaceAll('/+$', '') + &quot;/ofertas&quot;" returnTypeFixed="true" type="TYPE_READ_ONLY_SCRIPT" interpreter="GROOVY" returnType="java.lang.String"/>
              </parameters>
