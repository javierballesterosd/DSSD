perties() def env = new File(System.getProperty(&quot;rescuesync.env&quot;, &quot;C:/Users/Usuario/Documents/GitHub/DSSD/Proyecto/.env&quot;)) if (!env.isFile()) throw new IllegalStateException(&quot;No se encontró la configuración local de RescueSync&quot;) env.withInputStream { p.load(it) } def token = p.getProperty(&quot;BONITA_OFFERS_API_TOKEN&quot;)?.trim() if (!token) throw new IllegalStateException(&quot;Falta BONITA_OFFERS_API_TOKEN en la configuración local&quot;) return &quot;Bearer &quot; + token" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.String" interpreter="GROOVY"/></expressions></expression>
