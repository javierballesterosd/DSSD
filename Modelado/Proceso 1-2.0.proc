                <expression xmi:type="expression:Expression" xmi:id="_cIJX88jMEfGN1MGZ-YTPuA" name="URL backend RescueSync" content="def p = new java.util.Properties() def env = new File(System.getProperty(&quot;rescuesync.env&quot;, &quot;C:/Users/Usuario/Documents/GitHub/DSSD/Proyecto/.env&quot;)) if (!env.isFile()) throw new IllegalStateException(&quot;No se encontró la configuración local de RescueSync&quot;) env.withInputStream { p.load(it) } return &quot;http://localhost:&quot; + p.getProperty(&quot;BACKEND_PORT&quot;, p.getProperty(&quot;SERVER_PORT&quot;, &quot;8081&quot;)) + &quot;/api/emergencias/&quot; + emergenciaId + &quot;/ofertas-consolidadas&quot;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true" returnType="java.lang.String"><referencedElements xmi:id="_1dd5ad7c523d4e358aa2c44ee0cc6d97" xmi:type="process:Data" name="emergenciaId" dataType="_wovf_KfXEfGNCsJXQCfONg"/></expression>
