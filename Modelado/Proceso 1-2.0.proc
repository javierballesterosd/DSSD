        <connectors xmi:type="process:Connector" xmi:id="_f6ab9e07dfe54e6e9c8b04920fe7c2e5" documentation="Bonita se comunica directamente con el Sistema Nacional; configuracion externa sin credenciales embebidas." name="Login_SN" definitionId="rest-post" event="ON_FINISH" definitionVersion="1.5.1">
            <configuration xmi:type="connectorconfiguration:ConnectorConfiguration" xmi:id="_1287fc2c6431493bb07908577f904441" definitionId="rest-post" version="1.5.1" modelVersion="9">
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_3005f80c565c4c39972b1948251afa70" key="url">
                <expression xmi:type="expression:Expression" xmi:id="_0560d8878c4f4f94aee0cdee65eb141a" name="URL Sistema Nacional" content="def p = new java.util.Properties() def env = new File(System.getProperty(&quot;rescuesync.env&quot;, &quot;C:/Users/Usuario/Documents/GitHub/DSSD/Proyecto/.env&quot;)) if (!env.isFile()) throw new IllegalStateException(&quot;No se encontro la configuracion local de RescueSync&quot;) env.withInputStream { p.load(it) } def base = p.getProperty(&quot;NACIONAL_BASE_URL&quot;)?.trim() if (!base) throw new IllegalStateException(&quot;Falta NACIONAL_BASE_URL&quot;) return base.replaceAll('/+$', '') + &quot;/login&quot;" returnTypeFixed="true" type="TYPE_READ_ONLY_SCRIPT" interpreter="GROOVY" returnType="java.lang.String"/>
              </parameters>
